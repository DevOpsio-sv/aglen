/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 0
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-GSsJJ9LnXNxYQI3j3OodiSlvWJQvfsppnEXt+L01Up4='; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  # Prerendered HTML must revalidate: content and metadata change every build.
  Cache-Control: public, max-age=0, must-revalidate

# ── Caching ──────────────────────────────────────────────────────────────
# Later matches win, so these run from least to most specific.

# Images keep their source filename, so a replacement has to be able to take
# effect: a week in cache, served stale for a day while it revalidates.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Vite's bundles are content-hashed.
/assets/index-*
  Cache-Control: public, max-age=31536000, immutable

# Font filenames carry Google's content hash, so they can never go stale.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
